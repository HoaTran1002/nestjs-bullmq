NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgres://admin:your_secure_password@localhost:5432/nestjs-bullmq=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CACHE_DB=0
REDIS_BULL_DB=1

# Auth
JWT_SECRET=0123456789abcdef0123456789abcdef
JWT_EXPIRATION=60m
JWT_REFRESH_EXPIRATION=7d
BETTER_AUTH_SECRET=abcdef0123456789abcdef0123456789abcdef0123456789
BETTER_AUTH_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
LOG_REDACT=req.headers.authorization,req.headers.cookie,res.headers["set-cookie"],req.body.password,req.body.refresh_token

# BullMQ
BULLMQ_DEFAULT_JOB_ATTEMPTS=3
BULLMQ_DEFAULT_BACKOFF_DELAY=1000

# Health
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# WebSocket
WS_PORT=3001
WS_PATH=/ws

# Security
ENABLE_RATE_LIMITING=true
ENABLE_CORS=true
ENABLE_HELMET=true

# Monitoring
METRICS_PORT=9090

# Cache
CACHE_TTL=3600
CACHE_MAX=1000

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USE_SSL=false
MQTT_TOPIC_PREFIX=kocham

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIATESTACCESSKEY
AWS_SECRET_ACCESS_KEY=testsecretkey1234567890
S3_BUCKET_NAME=mock-bucket

# AWS SNS Push (provide at least one)
AWS_SNS_IOS_PLATFORM_APPLICATION_ARN=arn:aws:sns:us-east-1:123456789012:app/APNS_SANDBOX/mock-ios-app

# Social OAuth
GOOGLE_CLIENT_ID=mock-google-client-id
GOOGLE_CLIENT_SECRET=mock-google-client-secret
KAKAO_CLIENT_ID=mock-kakao-client-id
KAKAO_CLIENT_SECRET=mock-kakao-client-secret
NAVER_CLIENT_ID=mock-naver-client-id
NAVER_CLIENT_SECRET=mock-naver-secret

# Mailer
MAILER_SMTP_HOST=smtp.example.com
MAILER_SMTP_PORT=587
MAILER_SMTP_SECURE=false
MAILER_SMTP_USERNAME=test@example.com
MAILER_SMTP_PASSWORD=password123456
MAILER_DEFAULT_FROM_EMAIL=noreply@example.com
MAILER_DEFAULT_FROM_NAME=Mock Sender
MAILER_TLS_MIN_VERSION=TLSv1.2
MAILER_TLS_CIPHERS=ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384
MAILER_TLS_REJECT_UNAUTHORIZED=true

# Files
MAX_FILE_SIZE=10485760

# Google API
GOOGLE_API_KEY=mock-google-api-key